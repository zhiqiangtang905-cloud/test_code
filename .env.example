# Redis降级服务环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# 应用环境 (development/production/testing)
APP_ENV=development

# ==================== Redis配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=2
REDIS_SOCKET_CONNECT_TIMEOUT=2

# ==================== MySQL配置 ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=redis_gateway_info
MYSQL_CHARSET=utf8mb4

# MySQL连接池配置
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_RECYCLE=3600
MYSQL_POOL_PRE_PING=true

# ==================== 健康检查配置 ====================
# Redis不可用时的拨测间隔（秒）
HEALTH_CHECK_INTERVAL=10

# 过期数据清理间隔（秒）
CLEANUP_INTERVAL=60

# 分布式锁过期时间（秒）
LOCK_TTL=30

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ==================== 性能配置 ====================
# 是否启用异步MySQL写入
ASYNC_MYSQL_WRITE=true

# 异步写入超时时间（秒）
ASYNC_WRITE_TIMEOUT=5
